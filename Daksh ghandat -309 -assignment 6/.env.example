# Server
# Note: on macOS port 5000 is often occupied by AirPlay Receiver - if you get
# EADDRINUSE, switch to another free port (e.g. 8080).
PORT=5000
NODE_ENV=development

# JWT - use a long random string, e.g. `openssl rand -hex 32`
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRES_IN=24h

# Firebase Admin SDK (service account credentials)
# OPTION A (easiest): download the service account JSON and place it in the
# project root, then uncomment:
# FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
#
# OPTION B: copy the three fields from the service account JSON into .env
# (you generally only need ONE of the two options).
# Keep the \n line breaks inside FIREBASE_PRIVATE_KEY exactly as they appear in the JSON file.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Rate limiting (100 requests / 15 minutes per IP)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100